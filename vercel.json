{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "daemons": {
    "browser-worker": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "instances": {
        "sin1": 0
      },
      "resources": {
        "requests": {
          "memory": "2Gi"
        }
      },
      "terminationGracePeriodSeconds": 30
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 120,
        "excludeFiles": "{node_modules/**,runtime/**,data/**,work/**,tests/**,*.png,*.jpg}"
      }
    }
  ]
}
